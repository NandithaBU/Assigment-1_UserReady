# Copy to .env or export in your shell. Defaults target a local Ollama server.

# Provider: "openai" = any OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp)
DOCMETA_PROVIDER=openai
DOCMETA_BASE_URL=http://localhost:11434/v1
DOCMETA_MODEL=qwen2.5:7b-instruct          # text model for .docx
DOCMETA_VISION_MODEL=qwen2.5vl:7b          # vision model for scanned images
# DOCMETA_OCR=1                            # OCR scans instead, so a text-only model works
# DOCMETA_API_KEY=                         # only if your server requires one

# Few-shot examples from the labelled training set
# DOCMETA_TRAIN_CSV=data/train.csv
# DOCMETA_TRAIN_DIR=data/train
# DOCMETA_SHOTS=3

# DOCMETA_MAX_UPLOAD_MB=10
# Run a Hugging Face model in-process instead (needs the [hf] extra; text only, so use OCR for scans):
# DOCMETA_PROVIDER=transformers
# DOCMETA_MODEL=Qwen/Qwen2.5-3B-Instruct
# DOCMETA_DEVICE_MAP=auto
# DOCMETA_OCR=1
# Optional hosted provider instead: DOCMETA_PROVIDER=anthropic + ANTHROPIC_API_KEY
